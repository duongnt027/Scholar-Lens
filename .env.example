# Sao chép thành .env rồi chỉnh. Mọi biến đều tuỳ chọn.
# Docker: docker-compose.yml tự nạp file này vào container.

# ---- Embedding (PHẢI trùng với model đã dùng khi embedding trên máy GPU) ----
SL_EMBED_MODEL=intfloat/multilingual-e5-base

# ---- LLM ----
# Cách khuyên dùng: để trống ở đây, bật app rồi bấm nút LLM trên giao diện để dán URL trycloudflare.
# Cấu hình đặt từ giao diện được lưu ở data/llm_config.json và GHI ĐÈ các biến dưới đây.
SL_LLM_PROVIDER=none          # none = chế độ trích đoạn, không cần API

# (a) vLLM trên máy GPU, public qua trycloudflare (bash scripts/gpu_host_llm.sh in sẵn 4 dòng này)
# SL_LLM_PROVIDER=openai
# SL_LLM_BASE_URL=https://xxxx-yyyy.trycloudflare.com/v1
# SL_LLM_MODEL=Qwen2.5-7B-Instruct-AWQ
# SL_LLM_API_KEY=sl-...

# (b) Claude
# SL_LLM_PROVIDER=anthropic
# SL_LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# (c) Gemini qua endpoint tương thích OpenAI
# SL_LLM_PROVIDER=openai
# SL_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# SL_LLM_MODEL=gemini-2.5-flash
# SL_LLM_API_KEY=...

# Khoá của server vLLM đặt trong Kaggle Secrets (VLLM_API_KEY); phía app dán vào ô API key
# SL_LLM_API_KEY=<khoá-bí-mật>
